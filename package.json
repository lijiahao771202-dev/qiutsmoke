{
  "name": "rain",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "pages:build": "npx @cloudflare/next-on-pages --skip-build && echo 'Note: Some Node.js-only routes are skipped'",
    "pages:preview": "wrangler pages dev .vercel/output/static",
    "pages:deploy": "wrangler pages deploy .vercel/output/static"
  },
  "build": {
    "appId": "com.rain.meditation",
    "productName": "Rain",
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "electron.js",
      "preload.js",
      "out/**/*",
      "node_modules/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.88.0",
    "@vercel/postgres": "^0.10.0",
    "audiobuffer-to-wav": "^1.0.0",
    "clsx": "^2.1.1",
    "edge-tts": "^1.0.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "next": "15.5.2",
    "node-edge-tts": "^1.2.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "serve-handler": "^6.1.6",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "edgeone-pages-mcp": "^0.0.15",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.55.0"
  }
}