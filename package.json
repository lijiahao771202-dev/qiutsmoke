{
  "name": "rain",
  "version": "0.1.0",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "next dev -H ::",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder",
    "pages:build": "npx @cloudflare/next-on-pages --skip-build",
    "build:cf": "IS_CLOUDFLARE=true next build",
    "pages:deploy": "wrangler pages deploy out"
  },
  "build": {
    "appId": "com.rain.meditation",
    "productName": "Rain",
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "files": [
      "electron.js",
      "preload.js",
      "out/**/*",
      "node_modules/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.3",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/local-notifications": "^7.0.4",
    "@capacitor/motion": "^7.0.2",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@perfood/capacitor-healthkit": "^1.3.2",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.88.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/matter-js": "^0.20.2",
    "@vercel/postgres": "^0.10.0",
    "audiobuffer-to-wav": "^1.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "edge-tts": "^1.0.1",
    "framer-motion": "^12.23.24",
    "howler": "^2.2.4",
    "lucide-react": "^0.554.0",
    "matter-js": "^0.20.0",
    "next": "^16.1.0",
    "next-pwa": "^5.6.0",
    "node-edge-tts": "^1.2.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "serve-handler": "^6.1.6",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "edgeone-pages-mcp": "^0.0.15",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "^16.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.55.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.2.4"
  }
}
